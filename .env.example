# Copie este arquivo para `.env` em desenvolvimento local (com `vercel dev`)
# e configure os mesmos nomes em Project Settings > Environment Variables
# no painel da Vercel para produção/preview.

# Obrigatórias
GOOGLE_PLACES_API_KEY=coloque_sua_api_key_aqui
GOOGLE_PLACE_ID=coloque_o_place_id_da_clinica_aqui

# Opcionais — habilitam cache durável entre invocações via Upstash Redis
# (recomendado). Se deixadas em branco, a API usa apenas cache em memória
# da instância + cabeçalhos de cache HTTP como fallback.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
